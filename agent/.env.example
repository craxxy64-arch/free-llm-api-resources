# Any OpenAI-compatible provider (Groq, OpenRouter, Together, OpenAI, ...)
AGENT_BASE_URL=https://api.groq.com/openai/v1
AGENT_API_KEY=your-key-here
# Optional per-agent model override
# CODER_MODEL=llama-3.3-70b-versatile
# ARCHITECT_MODEL=llama-3.3-70b-versatile
PORT=8787
# Comma-separated origins allowed to call the API (your website). * = any
ALLOWED_ORIGINS=*
# run_command executes shell in the sandbox. Only enable if you trust your users / run in a container.
ENABLE_SHELL=false
RATE_LIMIT_PER_MIN=20
